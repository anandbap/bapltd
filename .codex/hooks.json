{
  "description": "BAP zero-trust lifecycle governance and prompt telemetry.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\bin\\interceptor.exe",
            "timeout": 10,
            "commandWindows": "C:\\Users\\User\\bin\\interceptor.exe"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\bin\\interceptor.exe",
            "timeout": 10,
            "commandWindows": "C:\\Users\\User\\bin\\interceptor.exe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\bin\\interceptor.exe",
            "timeout": 30,
            "commandWindows": "C:\\Users\\User\\bin\\interceptor.exe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\bin\\interceptor.exe",
            "timeout": 10,
            "commandWindows": "C:\\Users\\User\\bin\\interceptor.exe"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\bin\\interceptor.exe",
            "timeout": 3,
            "commandWindows": "C:\\Users\\User\\bin\\interceptor.exe"
          }
        ]
      }
    ]
  }
}